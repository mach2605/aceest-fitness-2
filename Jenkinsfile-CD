// Jenkinsfile-CD

pipeline {
    // Explicitly target the agent that has the Docker daemon accessible for building/pushing
    agent { label 'docker-build' } 
    
    // Trigger only on tags
    options {
        skipDefaultCheckout()
    }
    
    // Environment variables for Docker Hub credentials and image name
    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Validate Tag') {
            steps {
                script {
                    if (env.TAG_NAME == null || env.TAG_NAME == "") {
                        error "Pipeline must be triggered by a Git tag (e.g., v1.0.0). Aborting CD."
                    }
                    echo "Starting CD for image tag: ${env.TAG_NAME}"
                }
            }
        }
        
        stage('Checkout Manifests & Code') {
            steps {
                // Downloads the repository contents (code, Dockerfile, k8s YAMLs)
                checkout scm 
            }
        }

        stage('Build Image') {
            steps {
                script {
                    // Use the Git Tag (e.g., v1.0.0) as the definitive IMAGE_TAG
                    env.IMAGE_TAG = env.TAG_NAME 
                }
                echo "Building Docker image: ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                sh "docker build -t ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ."
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${env.DOCKERHUB_CREDENTIAL_ID}", 
                                                  passwordVariable: 'DOCKER_PASSWORD', 
                                                  usernameVariable: 'DOCKER_USERNAME')]) {
                    sh "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}"
                    
                    // Push the newly built image tagged with the Git Tag
                    sh "docker push ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                    
                    // Tag and push 'latest' for convenience
                    sh "docker tag ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ${env.DOCKER_IMAGE}:latest"
                    sh "docker push ${env.DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                script {
                    def CURRENT_TAG = env.TAG_NAME
                    
                    echo "Applying deployment with image tag: ${CURRENT_TAG}"
                    
                    def SCRIPT = "cd /workspace && " +
                                 "sed -i 's|\\\${IMAGE_TAG}|${CURRENT_TAG}|g' k8s/deployment.yaml && " +
                                 "kubectl apply -f k8s/pvc.yaml && " +
                                 "kubectl apply -f k8s/service.yaml && " +
                                 "kubectl apply -f k8s/deployment.yaml"

                    sh "docker run --rm --entrypoint '' -v \$(pwd):/workspace -v \$HOME/.kube:/root/.kube bitnami/kubectl:latest /bin/bash -c \\\"${SCRIPT}\\\""
                    
                    echo "Deployment complete. Check Minikube status on the host."
                }
            }
        }
        
        stage('Cleanup Workspace') {
            steps {
                deleteDir()
            }
        }
    }
}