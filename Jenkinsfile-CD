pipeline {
    agent { label 'docker-build-agent' }

    environment {
        REGISTRY = 'mach260595'
        IMAGE_NAME = 'aceest-fitness'
        K8S_DIR = 'k8s'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Detect Tag Version') {
            steps {
                script {
                // Detect tag from Jenkins env or Git directly
                    IMAGE_TAG = sh(
                        script: '''
                            TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "latest")
                            echo $TAG
                        ''',
                        returnStdout: true
                    ).trim()
                    echo "🏷️ Using image tag: ${IMAGE_TAG}"
                    env.IMAGE_TAG = IMAGE_TAG
                }
            }
        }

        stage('Verify Minikube Connectivity') {
            steps {
                script {
                    echo "⚙️ Verifying Minikube connectivity..."
                    sh '''
                        echo 📋 Current Context:
                        kubectl config current-context
                        echo 🌐 Cluster Info:
                        kubectl cluster-info
                        echo 🧩 Kubernetes Nodes:
                        kubectl get nodes
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "🐳 Building Docker image: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
                    sh "docker build -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Push to Docker Hub') {
            environment {
                DOCKERHUB_CREDS = credentials('dockerhub-cred')
            }
            steps {
                script {
                    echo "📤 Pushing Docker image to Docker Hub..."
                    sh '''
                        echo "${DOCKERHUB_CREDS_PSW}" | docker login -u "${DOCKERHUB_CREDS_USR}" --password-stdin
                        docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes (Minikube)') {
            steps {
                script {
                    echo "🚀 Deploying ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} to Minikube..."
                    sh """
                        echo 🔄 Updating image in ${K8S_DIR}/deployment.yaml...
                        sed -i "s|\\${IMAGE_TAG}|${IMAGE_TAG}|g" ${K8S_DIR}/deployment.yaml

                        echo 📦 Applying manifests...
                        kubectl apply -f ${K8S_DIR}/pvc.yaml
                        kubectl apply -f ${K8S_DIR}/service.yaml
                        kubectl apply -f ${K8S_DIR}/deployment.yaml

                        echo ⏳ Waiting for rollout...
                        kubectl rollout status deployment/aceest-fitness-deployment --timeout=180s

                        echo ✅ Deployment complete!
                        kubectl get pods -l app=aceest-fitness
                        kubectl get svc aceest-fitness-service

                        echo 🌍 Access your app at:
                        echo "http://$(minikube ip):$(kubectl get svc aceest-fitness-service -o jsonpath='{.spec.ports[0].nodePort}')"
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ CD pipeline executed successfully!"
        }
        failure {
            echo "❌ CD pipeline failed. Check logs for details."
        }
    }
}
