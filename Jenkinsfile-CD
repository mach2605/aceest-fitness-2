pipeline {
    agent { label 'docker-build' }

    options {
        skipDefaultCheckout()
    }

    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
        KUBE_CONTEXT = 'minikube'
    }

    stages {
        stage('Validate Tag') {
            steps {
                script {
                    if (!env.TAG_NAME?.trim()) {
                        error "❌ Pipeline must be triggered by a Git tag (e.g., v1.0.0)."
                    }
                    echo "🏷️ Starting CD for image tag: ${env.TAG_NAME}"
                }
            }
        }

        stage('Checkout Repository') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    env.IMAGE_TAG = env.TAG_NAME
                    echo "🛠️ Building Docker image: ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                    sh "docker build -t ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ."
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "${env.DOCKERHUB_CREDENTIAL_ID}",
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh """
                        echo "🔐 Logging into Docker Hub..."
                        echo "${DOCKER_PASSWORD}" | docker login -u "${DOCKER_USERNAME}" --password-stdin

                        echo "📦 Pushing image to Docker Hub..."
                        docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                        docker tag ${DOCKER_IMAGE}:${IMAGE_TAG} ${DOCKER_IMAGE}:latest
                        docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        stage('Setup Minikube Context') {
            steps {
                script {
                    echo "⚙️ Verifying Minikube context..."
                    sh '''
                        kubectl config use-context ${KUBE_CONTEXT}
                        kubectl cluster-info
                        kubectl get nodes
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    echo "🚀 Deploying image ${DOCKER_IMAGE}:${IMAGE_TAG} to Minikube..."

                    sh '''
                        echo "📁 Listing Kubernetes manifests..."
                        ls -la k8s/

                        echo "🔄 Updating deployment.yaml with image tag..."
                        sed -i "s|\\${IMAGE_TAG}|${IMAGE_TAG}|g" k8s/deployment.yaml

                        echo "📦 Applying manifests..."
                        kubectl apply -f k8s/pvc.yaml
                        kubectl apply -f k8s/service.yaml
                        kubectl apply -f k8s/deployment.yaml

                        echo "⏳ Waiting for rollout..."
                        kubectl rollout status deployment/aceest-fitness --timeout=120s

                        echo "✅ Deployment successful!"
                        kubectl get pods -l app=aceest-fitness
                        kubectl get svc aceest-fitness-service

                        echo "🌐 Minikube Service URL:"
                        minikube service aceest-fitness-service --url
                    '''
                }
            }
        }

        stage('Cleanup Workspace') {
            steps {
                deleteDir()
            }
        }
    }

    post {
        success {
            echo "✅ CD Pipeline completed successfully for tag ${env.TAG_NAME}"
        }
        failure {
            echo "❌ CD Pipeline failed. Check logs for details."
        }
    }
}
