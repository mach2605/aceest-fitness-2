pipeline {
  agent { label 'docker-build-agent' }

  environment {
    DOCKER_HUB_REPO = 'mach260595/aceest-fitness'
    K8S_DIR = 'k8s'
  }

  stages {

    stage('Skip if not a version tag') {
      when {
        expression {
          // Skip build if not triggered by a tag or tag doesn't start with "v"
          def tag = env.GIT_TAG_NAME ?: (env.GIT_BRANCH?.startsWith('refs/tags/') ? env.GIT_BRANCH.replace('refs/tags/', '') : null)
          return !(tag?.startsWith('v'))
        }
      }
      steps {
        echo "⏭️ Skipping CD: Tag does not start with 'v' or not a tag build."
        script { currentBuild.result = 'SUCCESS' }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Set Tag Name') {
      steps {
        script {
          // Extract tag name (e.g. v1.0.3)
          def tag = env.GIT_TAG_NAME ?: sh(script: "git describe --tags --abbrev=0", returnStdout: true).trim()
          env.IMAGE_TAG = tag
          echo "🏷️ Detected version tag: ${IMAGE_TAG}"
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          echo "🏗️ Building Docker image ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
          sh """
            docker build -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} .
            docker tag ${DOCKER_HUB_REPO}:${IMAGE_TAG} ${DOCKER_HUB_REPO}:latest
          """
        }
      }
    }

    stage('Push to Docker Hub') {
      steps {
        script {
          echo "📤 Pushing Docker image to Docker Hub..."
          sh """
            echo "$DOCKER_HUB_PASSWORD" | docker login -u "$DOCKER_HUB_USERNAME" --password-stdin
            docker push ${DOCKER_HUB_REPO}:${IMAGE_TAG}
            docker push ${DOCKER_HUB_REPO}:latest
          """
        }
      }
    }

    stage('Verify Minikube Connectivity') {
      steps {
        script {
          echo "⚙️ Checking Minikube connection..."
          sh """
            kubectl config current-context
            kubectl cluster-info
            kubectl get nodes
          """
        }
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        script {
          echo "🚀 Deploying ${DOCKER_HUB_REPO}:${IMAGE_TAG} to Minikube..."
          sh """
            echo 🔄 Updating image in ${K8S_DIR}/deployment.yaml...
            sed -i 's|\\${IMAGE_TAG}|${IMAGE_TAG}|g' ${K8S_DIR}/deployment.yaml

            echo 📦 Applying manifests...
            kubectl apply -f ${K8S_DIR}/pvc.yaml
            kubectl apply -f ${K8S_DIR}/service.yaml
            kubectl apply -f ${K8S_DIR}/deployment.yaml

            echo ⏳ Waiting for rollout...
            kubectl rollout status deployment/aceest-fitness-deployment --timeout=180s

            echo ✅ Deployment complete!
            kubectl get pods -l app=aceest-fitness
            kubectl get svc aceest-fitness-service

            echo 🌍 Access your app at:
            echo "http://\$(minikube ip):\$(kubectl get svc aceest-fitness-service -o jsonpath='{.spec.ports[0].nodePort}')"
          """
        }
      }
    }
  }

  post {
    success {
      echo "✅ CD pipeline succeeded! Image ${DOCKER_HUB_REPO}:${IMAGE_TAG} built and deployed successfully."
    }
    failure {
      echo "❌ CD pipeline failed. Check logs for details."
    }
  }
}
