pipeline {
  agent { label 'docker-build-agent' }

  environment {
    DOCKER_HUB_REPO = 'mach260595/aceest-fitness'
    K8S_DIR = 'k8s'
  }

  stages {

    stage('Skip if not a version tag') {
      when {
        expression {
          // Detect tag name from Git environment
          def tag = env.GIT_TAG_NAME ?: (
            env.GIT_BRANCH?.startsWith('refs/tags/') ?
            env.GIT_BRANCH.replace('refs/tags/', '') : null
          )
          // Only continue if tag starts with 'v'
          if (tag?.startsWith('v')) {
            env.IMAGE_TAG = tag
            return false // don't skip
          } else {
            return true // skip this pipeline
          }
        }
      }
      steps {
        echo "⏭️ Skipping CD: Not a version tag build."
        script { currentBuild.result = 'SUCCESS' }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Fix kubeconfig paths for Linux agent') {
      steps {
        script {
          echo "🧩 Fixing kubeconfig paths..."
          sh '''
            if [ -f /home/jenkins/.kube/config ]; then
              echo "🔧 Patching kubeconfig..."
              sed -i 's|C:\\\\Users\\\\cheth|/home/jenkins|g' /home/jenkins/.kube/config
              sed -i 's|\\\\|/|g' /home/jenkins/.kube/config
              echo "✅ kubeconfig patched successfully."
            else
              echo "⚠️ No kubeconfig found at /home/jenkins/.kube/config"
            fi
          '''
        }
      }
    }

    stage('Patch Minikube API endpoint') {
      steps {
        script {
          echo "🔧 Updating Minikube API endpoint..."
          sh '''
            MINIKUBE_IP=$(minikube ip)
            if [ -n "$MINIKUBE_IP" ]; then
              echo "🌐 Setting Minikube API to https://$MINIKUBE_IP:8443"
              sed -i "s|server: https://127.0.0.1:[0-9]*|server: https://$MINIKUBE_IP:8443|g" /home/jenkins/.kube/config
            else
              echo "⚠️ Could not fetch Minikube IP!"
            fi
          '''
        }
      }
    }

    stage('Verify Minikube Connectivity') {
      steps {
        script {
          echo "⚙️ Verifying Minikube connectivity..."
          sh """
            echo 📋 Current Context:
            kubectl config current-context

            echo 🌐 Cluster Info:
            kubectl cluster-info || true

            echo 🧩 Kubernetes Nodes:
            kubectl get nodes || true
          """
        }
      }
    }

    stage('Deploy to Kubernetes (Minikube)') {
      steps {
        script {
          def tag = env.IMAGE_TAG
          echo "🚀 Deploying ${DOCKER_HUB_REPO}:${tag} to Minikube..."

          sh """
            echo 🔄 Updating image in ${K8S_DIR}/deployment.yaml...
            sed -i "s|\\\${IMAGE_TAG}|${tag}|g" ${K8S_DIR}/deployment.yaml

            echo 📦 Applying manifests...
            kubectl apply -f \${K8S_DIR}/pvc.yaml
            kubectl apply -f \${K8S_DIR}/service.yaml
            kubectl apply -f \${K8S_DIR}/deployment.yaml

            echo ⏳ Waiting for rollout...
            kubectl rollout status deployment/aceest-fitness-deployment --timeout=180s

            echo ✅ Deployment complete!
            kubectl get pods -l app=aceest-fitness
            kubectl get svc aceest-fitness-service

            echo 🌍 Access your app at:
            echo "http://\$(minikube ip):\$(kubectl get svc aceest-fitness-service -o jsonpath='{.spec.ports[0].nodePort}')"
          """
        }
      }
    }
  }

  post {
    success {
      echo "✅ CD pipeline succeeded! Image ${DOCKER_HUB_REPO}:${env.IMAGE_TAG} built and deployed successfully."
    }
    failure {
      echo "❌ CD pipeline failed. Check logs for details."
    }
  }
}
