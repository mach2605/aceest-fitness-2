// Jenkinsfile-CD

pipeline {
    agent { label 'docker-build' } 
    
    options {
        skipDefaultCheckout()
    }
    
    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Validate Tag') {
            steps {
                script {
                    if (env.TAG_NAME == null || env.TAG_NAME == "") {
                        error "Pipeline must be triggered by a Git tag (e.g., v1.0.0). Aborting CD."
                    }
                    echo "Starting CD for image tag: ${env.TAG_NAME}"
                }
            }
        }
        
        stage('Checkout Manifests & Code') {
            steps {
                checkout scm 
            }
        }

        stage('Build Image') {
            steps {
                script {
                    env.IMAGE_TAG = env.TAG_NAME 
                }
                echo "Building Docker image: ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                sh "docker build -t ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ."
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${env.DOCKERHUB_CREDENTIAL_ID}", 
                                                  passwordVariable: 'DOCKER_PASSWORD', 
                                                  usernameVariable: 'DOCKER_USERNAME')]) {
                    sh "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}"
                    sh "docker push ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                    sh "docker tag ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ${env.DOCKER_IMAGE}:latest"
                    sh "docker push ${env.DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                script {
                    def CURRENT_TAG = env.TAG_NAME
                    
                    echo "Applying deployment with image tag: ${CURRENT_TAG}"
                    
                    // Debug: List files to verify they exist
                    sh "ls -la k8s/"
                    
                    // Update deployment.yaml with the current tag
                    sh "sed -i 's|\\${IMAGE_TAG}|${CURRENT_TAG}|g' k8s/deployment.yaml"
                    
                    echo "Deploying to Minikube..."
                    
                    def WORKSPACE_PATH = pwd()
                    
                    // Use minikube kubectl command from the host
                    // This is the proper way to run kubectl against a minikube cluster
                    sh """
                        # Install minikube in the agent if not present
                        if ! command -v minikube &> /dev/null; then
                            echo "Installing minikube..."
                            curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube-linux-amd64
                            install minikube-linux-amd64 /usr/local/bin/minikube
                            rm minikube-linux-amd64
                        fi
                        
                        # Use minikube kubectl to apply manifests
                        # This automatically uses the correct context
                        minikube kubectl -- apply -f ${WORKSPACE_PATH}/k8s/pvc.yaml
                        minikube kubectl -- apply -f ${WORKSPACE_PATH}/k8s/service.yaml
                        minikube kubectl -- apply -f ${WORKSPACE_PATH}/k8s/deployment.yaml
                        
                        # Wait for deployment to be ready
                        minikube kubectl -- rollout status deployment/aceest-fitness --timeout=120s
                        
                        # Show deployment status
                        echo "=== Deployment Status ==="
                        minikube kubectl -- get pods -l app=aceest-fitness
                        minikube kubectl -- get svc aceest-fitness-service
                        
                        echo "=== Service URL ==="
                        minikube service aceest-fitness-service --url
                    """
                    
                    echo "Deployment complete! Access your app with: minikube service aceest-fitness-service"
                }
            }
        }
        
        stage('Cleanup Workspace') {
            steps {
                deleteDir()
            }
        }
    }
    
    post {
        success {
            echo "✅ CD Pipeline completed successfully for tag ${env.TAG_NAME}"
        }
        failure {
            echo "❌ CD Pipeline failed. Check the logs above."
        }
    }
}