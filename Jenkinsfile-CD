pipeline {
  agent { label 'docker-build-agent' }

  environment {
    DOCKER_HUB_REPO = 'mach260595/aceest-fitness'
    K8S_DIR = 'k8s'
  }

  stages {

    stage('Detect Tag Build') {
      steps {
        script {
          echo "🔍 Checking if this build was triggered by a Git tag..."
          def tagName = sh(script: "git describe --tags --exact-match 2>/dev/null || true", returnStdout: true).trim()

          if (!tagName || !tagName.startsWith("v")) {
            echo "⏭️ Skipping CD: This is not a tag build (tag=$tagName)."
            currentBuild.result = 'SUCCESS'
            error("Stopping pipeline — only tag builds trigger CD.")
          }

          env.IMAGE_TAG = tagName
          echo "🏷️ Detected tag build: ${env.IMAGE_TAG}"
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Fix kubeconfig paths for Linux agent') {
      steps {
        script {
          sh '''
            if [ -f /home/jenkins/.kube/config ]; then
              echo "🔧 Fixing kubeconfig paths..."
              sed -i 's|C:\\\\Users\\\\cheth|/home/jenkins|g' /home/jenkins/.kube/config
              sed -i 's|\\\\|/|g' /home/jenkins/.kube/config
              echo "✅ kubeconfig fixed successfully."
            else
              echo "⚠️ No kubeconfig found at /home/jenkins/.kube/config"
            fi
          '''
        }
      }
    }

    stage('Patch Minikube API endpoint') {
      steps {
        script {
          sh '''
            MINIKUBE_IP=$(minikube ip)
            if [ -n "$MINIKUBE_IP" ]; then
              echo "🌐 Setting Minikube API to https://$MINIKUBE_IP:8443"
              sed -i "s|server: https://127.0.0.1:[0-9]*|server: https://$MINIKUBE_IP:8443|g" /home/jenkins/.kube/config
            else
              echo "⚠️ Could not fetch Minikube IP!"
            fi
          '''
        }
      }
    }

    stage('Build & Push Docker Image') {
      steps {
        script {
          echo "🏗️ Building and pushing image: ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
          withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_HUB_USERNAME', passwordVariable: 'DOCKER_HUB_PASSWORD')]) {
            sh """
              docker build -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} .
              echo "$DOCKER_HUB_PASSWORD" | docker login -u "$DOCKER_HUB_USERNAME" --password-stdin
              docker push ${DOCKER_HUB_REPO}:${IMAGE_TAG}
              docker tag ${DOCKER_HUB_REPO}:${IMAGE_TAG} ${DOCKER_HUB_REPO}:latest
              docker push ${DOCKER_HUB_REPO}:latest
            """
          }
        }
      }
    }

    stage('Verify Minikube Connectivity') {
      steps {
        sh '''
          echo 📋 Current Context:
          kubectl config current-context

          echo 🌐 Cluster Info:
          kubectl cluster-info

          echo 🧩 Kubernetes Nodes:
          kubectl get nodes
        '''
      }
    }

    stage('Cleanup Old Blue/Green Deployments') {
      steps {
        script {
          echo "🧹 Cleaning up old Blue/Green deployments..."
          sh """
            kubectl delete deployment aceest-fitness-blue --ignore-not-found
            kubectl delete deployment aceest-fitness-green --ignore-not-found
          """
        }
      }
    }

    stage('Blue-Green Deployment') {
      steps {
        script {
          echo "🟩 Starting Blue-Green deployment..."
          sh """
            kubectl apply -f ${K8S_DIR}/pvc.yaml
            kubectl apply -f ${K8S_DIR}/service.yaml
          """

          // Randomly start with Blue for first deployment
          def currentVersion = sh(script: "kubectl get svc aceest-fitness-service -o jsonpath='{.spec.selector.version}' 2>/dev/null || echo 'none'", returnStdout: true).trim()
          def newVersion = (currentVersion == "blue") ? "green" : "blue"
          echo "🔁 Deploying new version as ${newVersion}"

          sh """
            sed -i "s|\\\${IMAGE_TAG}|${IMAGE_TAG}|g" ${K8S_DIR}/deployment-${newVersion}.yaml
            kubectl apply -f ${K8S_DIR}/deployment-${newVersion}.yaml
            kubectl rollout status deployment/aceest-fitness-${newVersion} --timeout=180s

            echo "🔀 Switching traffic to ${newVersion}"
            kubectl patch svc aceest-fitness-service -p '{"spec":{"selector":{"app":"aceest-fitness","version":"${newVersion}"}}}'
          """

          echo "✅ Blue-Green Deployment complete! Traffic now on ${newVersion}."
        }
      }
    }

    stage('Verify Deployment Status') {
      steps {
        echo "🔎 Verifying pods and service status..."
        sh """
          kubectl get deployments
          kubectl get pods -l app=aceest-fitness -o wide
          kubectl get svc aceest-fitness-service
        """
      }
    }
  }

  post {
    success {
      echo "✅ CD pipeline succeeded! Deployed ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
    }
    failure {
      echo "❌ CD pipeline failed. Check logs for details."
    }
  }
}
