pipeline {
    agent { label 'docker-build-agent' }

    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
    }

    stages {

        stage('Validate Tag') {
            steps {
                script {
                    if (!env.TAG_NAME?.trim()) {
                        error "❌ Pipeline must be triggered by a Git tag (e.g., v1.0.0). Aborting CD."
                    }
                    echo "🏷️ Deploying image tag: ${env.TAG_NAME}"
                }
            }
        }

        stage('Checkout Repository') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "🛠️ Building Docker image: ${DOCKER_IMAGE}:${env.TAG_NAME}"
                    sh "docker build -t ${DOCKER_IMAGE}:${env.TAG_NAME} ."
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "${env.DOCKERHUB_CREDENTIAL_ID}",
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "🔐 Logging into Docker Hub..."
                        echo "${DOCKER_PASSWORD}" | docker login -u "${DOCKER_USERNAME}" --password-stdin

                        echo "📦 Pushing Docker image..."
                        docker push ${DOCKER_IMAGE}:${TAG_NAME}
                        docker tag ${DOCKER_IMAGE}:${TAG_NAME} ${DOCKER_IMAGE}:latest
                        docker push ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Verify Minikube Connectivity') {
            steps {
                script {
                    echo "⚙️ Verifying Minikube connectivity..."
                    sh '''
                        echo "📋 Current Context:"
                        kubectl config current-context

                        echo "🌐 Cluster Info:"
                        kubectl cluster-info

                        echo "🧩 Kubernetes Nodes:"
                        kubectl get nodes
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes (Minikube)') {
            steps {
                script {
                    echo "🚀 Deploying ${DOCKER_IMAGE}:${TAG_NAME} to Minikube..."
                    sh '''
                        echo "🔄 Updating image in k8s/deployment.yaml..."
                        sed -i "s|\\${IMAGE_TAG}|${TAG_NAME}|g" k8s/deployment.yaml || true

                        echo "📦 Applying manifests..."
                        kubectl apply -f k8s/pvc.yaml
                        kubectl apply -f k8s/service.yaml
                        kubectl apply -f k8s/deployment.yaml

                        echo "⏳ Waiting for rollout..."
                        kubectl rollout status deployment/aceest-fitness --timeout=180s

                        echo "✅ Deployment complete!"
                        kubectl get pods -l app=aceest-fitness
                        kubectl get svc aceest-fitness-service

                        echo "🌍 Access your app via:"
                        minikube service aceest-fitness-service --url
                    '''
                }
            }
        }

        stage('Cleanup') {
            steps {
                echo "🧹 Cleaning workspace..."
                deleteDir()
            }
        }
    }

    post {
        success {
            echo "✅ CD pipeline completed successfully for ${env.TAG_NAME}"
        }
        failure {
            echo "❌ CD pipeline failed. Check logs for details."
        }
    }
}
