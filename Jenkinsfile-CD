// Jenkinsfile-CD
pipeline {
    agent any 
    
    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Validate Tag') {
            steps {
                script {
                    if (env.TAG_NAME == null || env.TAG_NAME == "") {
                        error "Pipeline must be triggered by a Git tag (e.g., v1.0.0). Aborting CD."
                    }
                    echo "Starting CD for image tag: ${env.TAG_NAME}"
                }
            }
        }
        
        stage('Checkout Manifests & Code') {
            steps {
                checkout scm 
            }
        }

        stage('Build Image') {
            steps {
                script {
                    env.IMAGE_TAG = env.TAG_NAME 
                }
                echo "Building Docker image: ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                sh "docker build -t ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ."
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${env.DOCKERHUB_CREDENTIAL_ID}", 
                                                  passwordVariable: 'DOCKER_PASSWORD', 
                                                  usernameVariable: 'DOCKER_USERNAME')]) {
                    sh "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}"
                    sh "docker push ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                    sh "docker tag ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ${env.DOCKER_IMAGE}:latest"
                    sh "docker push ${env.DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Minikube') {
            agent {
                docker {
                    image 'bitnami/kubectl:latest'
                    // This mount makes the Kube configuration (usually for Minikube) available to the container.
                    args "-v $HOME/.kube:/root/.kube" 
                }
            }
            steps {
                script {
                    def CURRENT_TAG = env.TAG_NAME
                    
                    echo "Applying deployment with image tag: ${CURRENT_TAG}"
                    
                    // 1. Substitute the placeholder ${IMAGE_TAG} in deployment.yaml
                    // This sed command runs inside the kubectl container now.
                    sh "sed -i 's|\\\${IMAGE_TAG}|${CURRENT_TAG}|g' k8s/deployment.yaml"
                    
                    // 2. Apply all Kubernetes manifests (kubectl commands run successfully inside the container)
                    sh "kubectl apply -f k8s/pvc.yaml"
                    sh "kubectl apply -f k8s/service.yaml"
                    sh "kubectl apply -f k8s/deployment.yaml" 
                    
                    echo "Deployment complete."
                    // The 'minikube service' command is omitted here as it may not be available inside the kubectl container.
                    // You must run this command manually on the host where Minikube is running: 
                    // minikube service aceest-fitness-service --url
                }
            }
        }
        
        stage('Cleanup Workspace') {
            steps {
                deleteDir()
            }
        }
    }
}