pipeline {
    agent { label 'docker-build' }

    stages {

        stage('Test, Lint & Coverage') {
            steps {
                echo "🧪 Running tests, linting, and collecting coverage..."
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                    pip install -r requirements-dev.txt

                    echo "▶️ Running tests with coverage..."
                    pytest --junitxml=results.xml --cov=. --cov-report=xml --cov-report=term-missing || true

                    echo "🔍 Test Summary:"
                    passed=$(grep -o 'PASSED' results.xml | wc -l || true)
                    failed=$(grep -o 'FAILED' results.xml | wc -l || true)
                    skipped=$(grep -o 'SKIPPED' results.xml | wc -l || true)
                    echo "✅ Passed: $passed  ❌ Failed: $failed  ⚠️ Skipped: $skipped"
                '''
            }
            post {
                always {
                    echo "📊 Publishing test & coverage results..."
                    junit 'results.xml'
                    cobertura coberturaReportFile: 'coverage.xml', autoUpdateHealth: false, autoUpdateStability: false
                    archiveArtifacts artifacts: 'results.xml, coverage.xml', fingerprint: true
                }
            }
        }

        stage('SonarQube Analysis') {
            environment {
                scannerHome = tool 'SonarScanner'
            }
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_AUTH_TOKEN')]) {
                    withSonarQubeEnv('sonarqube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=aceest-fitness \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.python.coverage.reportPaths=coverage.xml \
                            -Dsonar.login=${SONAR_AUTH_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo "📦 Archiving SonarQube and coverage artifacts..."
                sh 'ls -R .scannerwork || true'
                archiveArtifacts artifacts: '**/.scannerwork/**/*, coverage.xml, results.xml', allowEmptyArchive: true, fingerprint: true
            }
        }

        stage('Cleanup') {
            steps {
                echo "🧹 Cleaning up workspace..."
                deleteDir()
            }
        }
    }

    post {
        success {
            echo "✅ CI Pipeline completed successfully! All tests passed and code analyzed."
        }
        failure {
            echo "❌ CI Pipeline failed. Check logs for errors."
        }
    }
}
