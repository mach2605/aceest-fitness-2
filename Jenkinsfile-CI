pipeline {
    agent { label 'docker-build' }

    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Test & Lint') {
            steps {
                echo "🧪 Running unit tests and lint checks..."
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                    pip install -r requirements-dev.txt
                    # Run pytest with JUnit XML output for Jenkins
                    pytest --junitxml=results.xml
                '''
            }
            post {
                always {
                    echo "📊 Publishing test results..."
                    junit 'results.xml' // ✅ Publish JUnit test report
                }
            }
        }

        stage('SonarQube Analysis') {
            environment {
                scannerHome = tool 'SonarScanner'
            }
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_AUTH_TOKEN')]) {
                    withSonarQubeEnv('sonarqube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=aceest-fitness \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.python.coverage.reportPaths=coverage.xml \
                            -Dsonar.login=${SONAR_AUTH_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo "📦 Archiving SonarQube artifacts..."
                sh 'ls -R .scannerwork || true'
                archiveArtifacts artifacts: '**/.scannerwork/**/*', allowEmptyArchive: true, fingerprint: true
            }
        }

        stage('Cleanup') {
            steps {
                echo "🧹 Cleaning up workspace..."
                deleteDir()
            }
        }
    }

    post {
        always {
            echo "✅ CI Pipeline completed successfully!"
        }
    }
}
