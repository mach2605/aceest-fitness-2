pipeline {
    agent { label 'docker-build' } 
    
    options {
        // This is the permanent fix for checkout issues
        cleanWs() 
    }
    
    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Test & Lint') {
            steps {
                echo "Running unit tests and code checks on dedicated agent..."
                sh 'python3 -m venv venv'
                sh '. venv/bin/activate && pip install -r requirements.txt'
                sh '. venv/bin/activate && pip install -r requirements-dev.txt'
                sh '. venv/bin/activate && python3 -m pytest' 
            }
        }
        
        stage('Build Image') {
            steps {
                script {
                    env.IMAGE_TAG = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                }
                echo "Building Docker image: ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                // Runs as root due to the -u 0 flag on the agent
                [cite_start]sh "docker build -t ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ." [cite: 9]
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${env.DOCKERHUB_CREDENTIAL_ID}", 
                                                  passwordVariable: 'DOCKER_PASSWORD', 
                                                  usernameVariable: 'DOCKER_USERNAME')]) {
                    // Runs as root due to the -u 0 flag on the agent
                    [cite_start]sh "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}" [cite: 10]
                    [cite_start]sh "docker push ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}" [cite: 11]
                    sh "docker tag ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} ${env.DOCKER_IMAGE}:latest"
                    sh "docker push ${env.DOCKER_IMAGE}:latest"
                }
            }
        }
    }
}