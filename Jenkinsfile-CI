pipeline {
    agent { label 'docker-build' } 

    environment {
        DOCKER_IMAGE = "mach260595/aceest-fitness"
        DOCKERHUB_CREDENTIAL_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Test & Lint') {
            steps {
                echo "Running unit tests and code checks on dedicated agent..."
                sh 'python3 -m venv venv'
                sh '. venv/bin/activate && pip install -r requirements.txt'
                sh '. venv/bin/activate && pip install -r requirements-dev.txt' 
                sh '. venv/bin/activate && python3 -m pytest' 
            }
        }
        


        stage('Cleanup') {
            steps {
                echo "Cleaning up workspace on agent..."
                deleteDir() 
            }
        }
    }
}